{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/element-bendr/icm-repo-template/schemas/icm-result.schema.json",
  "title": "ICM Local Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","task_id","repository","workflow_id","stage_id","base_sha","candidate_sha","claim_ref","executor_identity","execution","status","changed_paths","validation","protected_state","blockers","next_action"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "result" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$", "maxLength": 128 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200 },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$", "maxLength": 128 },
    "stage_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$", "maxLength": 128 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": ["string","null"], "pattern": "^[0-9a-f]{40}$" },
    "candidate_ref": { "type": "string", "pattern": "^refs/heads/icm/candidates/[a-z0-9][a-z0-9._-]{2,127}$", "maxLength": 184 },
    "claim_ref": { "type": "string", "pattern": "^refs/heads/icm/claims/[a-z0-9][a-z0-9._-]{2,127}$", "maxLength": 180 },
    "executor_identity": { "type": "string", "minLength": 1, "maxLength": 160 },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["branch","worktree_id"],
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 240 },
        "worktree_id": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "status": { "enum": ["pass","fail","stop","error"] },
    "changed_paths": {
      "type": "array", "maxItems": 512, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
    },
    "validation": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id","status","summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64 },
          "status": { "enum": ["pass","fail","skipped"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidence_ref": { "type": ["string","null"], "maxLength": 500 }
        }
      }
    },
    "protected_state": { "enum": ["unchanged","violated","unknown"] },
    "blockers": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "next_action": { "enum": ["await_review","fix_required","escalate"] }
  }
}
