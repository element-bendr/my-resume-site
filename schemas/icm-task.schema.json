{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/element-bendr/icm-repo-template/schemas/icm-task.schema.json",
  "title": "ICM Local Execution Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","task_id","repository","workflow_id","stage_id","base_sha","trusted_ref","origin","executor_profile","review_policy","scope","write_paths","protected_paths","protected_refs","acceptance","validation","stop_conditions","claim"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "task" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$", "maxLength": 128 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200 },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$", "maxLength": 128 },
    "stage_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$", "maxLength": 128 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trusted_ref": { "type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$", "maxLength": 240 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","ref","actor","commit_sha"],
      "properties": {
        "kind": { "const": "same_repository_control" },
        "ref": { "type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$", "maxLength": 240 },
        "actor": { "type": "string", "minLength": 1, "maxLength": 100 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "executor_profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "maxLength": 64 },
    "review_policy": { "const": "independent" },
    "scope": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "write_paths": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\*\\*?$).+" }
    },
    "protected_paths": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
    },
    "protected_refs": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$", "maxLength": 240 }
    },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "validation": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64 }
    },
    "stop_conditions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy","ref_prefix","allow_force_update","stale_takeover"],
      "properties": {
        "strategy": { "const": "atomic_git_ref" },
        "ref_prefix": { "const": "refs/heads/icm/claims/" },
        "allow_force_update": { "const": false },
        "stale_takeover": { "const": "coordinator_authorized_only" }
      }
    }
  }
}
