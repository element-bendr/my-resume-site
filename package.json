{
  "name": "vijay-kumaran-portfolio-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22 <23"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "art:blender": "blender -b --python tools/blender/generate_world.py",
    "art:verify": "node scripts/check-blender-assets.mjs",
    "verify:content": "node scripts/check-content.mjs",
    "verify:assets": "node scripts/check-asset-budget.mjs",
    "verify": "npm run verify:offline && npm test && npm run build && npm run verify:assets && npm run verify:world-assets",
    "deploy": "npm run verify && wrangler deploy",
    "verify:boundary": "node scripts/check-foundation-boundary.mjs",
    "verify:config": "node scripts/check-foundation-config.mjs",
    "verify:offline": "npm run verify:content && npm run verify:config && npm run verify:world && npm run verify:world-zones",
    "verify:world": "node scripts/check-world-boundary.mjs",
    "verify:world-assets": "node scripts/check-world-budget.mjs",
    "verify:ask-disclosure": "node scripts/check-ask-client-disclosure.mjs",
    "verify:world-ask": "node scripts/check-world-ask-boundary.mjs",
    "verify:world-zones": "node scripts/check-world-zones.mjs",
    "art:cc:bootstrap": "blender -b --python tools/blender/bootstrap_command_center.py",
    "art:cc:validate": "blender -b art/blender/command-center/source/command-center.blend --python tools/blender/validate_command_center_source.py",
    "art:cc:preview": "blender -b art/blender/command-center/source/command-center.blend --python tools/blender/render_command_center_preview.py",
    "art:cc:export": "blender -b art/blender/command-center/source/command-center.blend --python tools/blender/export_command_center.py"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1",
    "@types/three": "0.186.0"
  }
}
