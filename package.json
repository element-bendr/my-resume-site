{
  "name": "vijay-kumaran-portfolio-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "verify:content": "node scripts/check-content.mjs",
    "verify:assets": "node scripts/check-asset-budget.mjs",
    "verify": "npm run verify:content && npm run verify:boundary && npm test && npm run build && npm run verify:assets",
    "deploy": "npm run verify && wrangler deploy",
    "verify:boundary": "node scripts/check-foundation-boundary.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
